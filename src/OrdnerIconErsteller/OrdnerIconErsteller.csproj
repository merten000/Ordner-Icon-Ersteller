<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>OrdnerIconErsteller</AssemblyName>
    <RootNamespace>OrdnerIconErsteller</RootNamespace>
    <!-- Kein eigenes app.ico hinterlegt (MVP) - Windows-Standardicon wird verwendet.
         Kann später ergänzt werden: <ApplicationIcon>app.ico</ApplicationIcon> -->

    <!-- Versionsinfo -->
    <Version>2.7.2</Version>
    <Product>Ordner-Icon-Ersteller</Product>
    <Company>Merten</Company>
    <Copyright>© Merten</Copyright>

    <!-- Bewusst KEINE Selbst-Erhöhung auf Administratorrechte:
         alles läuft im Kontext des angemeldeten Benutzers (HKCU),
         das ist einer der Gründe für die Fehlalarme der alten Version. -->
  </PropertyGroup>

  <!-- Hinweis (ChatGPT-Prüfung v2.0.0): System.Drawing.Common und
       Microsoft.Win32.Registry sind für net8.0-windows mit UseWindowsForms=true
       bereits über das Microsoft.WindowsDesktop.App-Shared-Framework bzw. die
       windows-spezifischen Referenzassemblies verfügbar - eigene NuGet-Pakete
       waren unnötig und wurden entfernt. -->

  <ItemGroup>
    <InternalsVisibleTo Include="OrdnerIconErsteller.Tests" />
  </ItemGroup>

  <!-- Die mitgelieferten rechtlichen Dokumente (siehe LegalDocumentService) werden
       hier NICHT als Ressource eingebettet, sondern als eigene Dateien neben die EXE
       kopiert - der "Rechtliches"-Bereich im Programm liest sie zur Laufzeit direkt
       ein, damit Programm und ausgelieferte Dateien nie auseinanderlaufen. Der
       Installer (OrdnerIconErsteller.iss) kopiert denselben "legal"-Unterordner an
       dieselbe relative Stelle neben die installierte EXE. -->
  <ItemGroup>
    <None Include="legal\*.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Pruefbericht v2.7.1, Freigabeblocker 1: als selbstenthaltene .NET-8-Windows-
       Anwendung buendelt diese App Teile der .NET-Runtime mit aus. Nach dem
       offiziellen .NET Asset Licensing Model muss jede .NET-Binaerdistribution
       (auch der Installer) deren Lizenz und Drittanbieterhinweise mitfuehren. Die
       beiden Dateien stammen unveraendert aus dem tatsaechlich verwendeten
       Runtime-Paket Microsoft.NETCore.App.Runtime.win-x64 8.0.31 und werden - wie
       die eigenen Rechtstexte oben - unveraendert neben die EXE kopiert
       (Unterordner "legal\dotnet-runtime", siehe LegalDocumentService). -->
  <ItemGroup>
    <None Include="legal\dotnet-runtime\*.TXT">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
