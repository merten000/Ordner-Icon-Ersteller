<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>OrdnerIconErsteller</AssemblyName>
    <RootNamespace>OrdnerIconErsteller</RootNamespace>
    <!-- Kein eigenes app.ico hinterlegt (MVP) - Windows-Standardicon wird verwendet.
         Kann später ergänzt werden: <ApplicationIcon>app.ico</ApplicationIcon> -->

    <!-- Versionsinfo -->
    <Version>2.2.0</Version>
    <Product>Ordner-Icon-Ersteller</Product>
    <Company>Merten</Company>
    <Copyright>© Merten</Copyright>

    <!-- Bewusst KEINE Selbst-Erhöhung auf Administratorrechte:
         alles läuft im Kontext des angemeldeten Benutzers (HKCU),
         das ist einer der Gründe für die Fehlalarme der alten Version. -->
  </PropertyGroup>

  <!-- Hinweis (ChatGPT-Prüfung v2.0.0): System.Drawing.Common und
       Microsoft.Win32.Registry sind für net8.0-windows mit UseWindowsForms=true
       bereits über das Microsoft.WindowsDesktop.App-Shared-Framework bzw. die
       windows-spezifischen Referenzassemblies verfügbar - eigene NuGet-Pakete
       waren unnötig und wurden entfernt. -->

  <ItemGroup>
    <InternalsVisibleTo Include="OrdnerIconErsteller.Tests" />
  </ItemGroup>

</Project>
